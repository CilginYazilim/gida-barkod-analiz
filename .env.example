# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# CI4 (erp.cilginyazilim.com) backend entegrasyonu — gerçek değerler .env'de.
CI4_API_BASE_URL=https://cilginyazilim.com/api/v1
CI4_API_KEY=BURAYA_PANELDEN_URETILEN_TOKEN

# Google Sign-In — Google Cloud Console > Kimlik Bilgileri > Web istemci ID'si
GOOGLE_WEB_CLIENT_ID=BURAYA_GOOGLE_WEB_ISTEMCI_ID_YAZIN
